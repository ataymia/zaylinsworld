{
  "name": "zaylinsworld",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zaylins World — an optimized, browser-playable 3D open-world game built with Three.js + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "check:syntax": "node tools/check-source.mjs",
    "check:smoke": "node tools/smoke-structure.mjs",
    "check:characters": "node tools/check-character-policy.mjs",
    "check:player-runtime": "node tools/check-player-runtime.mjs",
    "check:runtime-foundation": "node tools/check-runtime-foundation.mjs",
    "check:starter-town-phases": "node tools/check-starter-town-phases.mjs",
    "check:functional-relocation": "node tools/check-functional-relocation.mjs",
    "check:home-relocation": "node tools/check-home-relocation.mjs",
    "check:school-relocation": "node tools/check-school-relocation.mjs",
    "check:chicken-relocation": "node tools/check-chicken-relocation.mjs",
    "check:story": "node tools/check-story-system.mjs",
    "story:check-full": "node tools/check-full-story-content.mjs",
    "story:compile": "node tools/compile-story-content.mjs",
    "check": "npm run check:syntax && npm run check:smoke && npm run check:characters && npm run check:player-runtime && npm run check:runtime-foundation && npm run check:starter-town-phases && npm run check:functional-relocation && npm run check:home-relocation && npm run check:school-relocation && npm run check:chicken-relocation && npm run check:story && npm run story:check-full && npm run build",
    "audit:characters": "node tools/audit-characters.mjs",
    "audit:assets": "node tools/audit-assets.mjs",
    "build:player-avatar": "node tools/build-player-avatar.mjs",
    "gen:gem": "node tools/make-sample-gem.mjs",
    "gen:assets": "node tools/build-assets.mjs",
    "gen:asset-report": "node scripts/gen-asset-report.mjs",
    "index:kits": "node tools/index-kits.mjs",
    "organize": "node tools/organize-assets.mjs",
    "asset:compile-baseline": "node tools/asset-factory/compile-specs.mjs",
    "asset:catalog": "node tools/asset-factory/build-final-gameplay-gap-catalog.mjs",
    "asset:apply-gap": "node tools/asset-factory/apply-gameplay-gap-catalog-v2.mjs",
    "asset:promote-builders": "node tools/asset-factory/promote-safe-builders.mjs",
    "asset:check-gap": "node tools/asset-factory/check-gameplay-gap-catalog-v2.mjs",
    "asset:compile-expanded": "node tools/asset-factory/compile-expanded-specs.mjs",
    "asset:compile": "npm run asset:compile-expanded",
    "asset:runtime": "node tools/asset-factory/build-runtime-deliverables.mjs",
    "asset:health": "node tools/asset-factory/audit-factory-health.mjs",
    "asset:enrich": "node tools/asset-factory/enrich-all-specs.mjs",
    "asset:normalize-deep": "node tools/asset-factory/normalize-deep-specs.mjs",
    "asset:refine-deep": "node tools/asset-factory/refine-deep-semantics.mjs",
    "asset:finalize-deep": "node tools/asset-factory/finalize-deep-semantics.mjs",
    "asset:derive-physical": "node tools/asset-factory/derive-physical-specs.mjs",
    "asset:specialize-physical": "node tools/asset-factory/specialize-physical-specs.mjs",
    "asset:audit-inventory": "node tools/asset-factory/classify-inventory-intent.mjs",
    "asset:check-deep": "node tools/asset-factory/check-deep-specs.mjs",
    "asset:check-physical": "node tools/asset-factory/check-physical-specs.mjs",
    "asset:check-specialized": "node tools/asset-factory/check-specialized-physical-specs.mjs",
    "asset:check-inventory": "node tools/asset-factory/check-inventory-intent.mjs",
    "asset:shard-deep": "node tools/asset-factory/bounded-shard-deep-specs.mjs",
    "asset:check-shards": "node tools/asset-factory/check-bounded-deep-shards.mjs",
    "asset:deep-only": "npm run asset:enrich && npm run asset:normalize-deep && npm run asset:refine-deep && npm run asset:finalize-deep && npm run asset:derive-physical && npm run asset:specialize-physical && npm run asset:finalize-deep && npm run asset:audit-inventory && npm run asset:check-deep && npm run asset:check-physical && npm run asset:check-specialized && npm run asset:check-inventory && npm run asset:shard-deep && npm run asset:check-shards",
    "asset:deep": "npm run asset:compile-expanded && npm run asset:deep-only",
    "asset:materialize": "npm run asset:compile-expanded && npm run asset:runtime && npm run asset:deep-only && npm run asset:health",
    "asset:batch": "node tools/asset-factory/run-batch.mjs --batch-size 20",
    "asset:dry-run": "node tools/asset-factory/run-batch.mjs --batch-size 20 --dry-run"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
