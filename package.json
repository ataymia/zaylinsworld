{
  "name": "zaylinsworld",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Zaylins World — an optimized, browser-playable 3D open-world game built with Three.js + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "check:syntax": "node tools/check-source.mjs",
    "check:smoke": "node tools/smoke-structure.mjs",
    "check:characters": "node tools/check-character-policy.mjs",
    "check:player-runtime": "node tools/check-player-runtime.mjs",
    "check": "npm run check:syntax && npm run check:smoke && npm run check:characters && npm run check:player-runtime && npm run build",
    "audit:characters": "node tools/audit-characters.mjs",
    "audit:assets": "node tools/audit-assets.mjs",
    "build:player-avatar": "node tools/build-player-avatar.mjs",
    "gen:gem": "node tools/make-sample-gem.mjs",
    "gen:assets": "node tools/build-assets.mjs",
    "gen:asset-report": "node scripts/gen-asset-report.mjs",
    "index:kits": "node tools/index-kits.mjs",
    "organize": "node tools/organize-assets.mjs",
    "asset:compile": "node tools/asset-factory/compile-specs.mjs",
    "asset:enrich": "node tools/asset-factory/enrich-all-specs.mjs",
    "asset:normalize-deep": "node tools/asset-factory/normalize-deep-specs.mjs",
    "asset:refine-deep": "node tools/asset-factory/refine-deep-semantics.mjs",
    "asset:check-deep": "node tools/asset-factory/check-deep-specs.mjs",
    "asset:deep": "npm run asset:enrich && npm run asset:normalize-deep && npm run asset:refine-deep && npm run asset:check-deep",
    "asset:batch": "node tools/asset-factory/run-batch.mjs --batch-size 10",
    "asset:dry-run": "node tools/asset-factory/run-batch.mjs --batch-size 10 --dry-run"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "vite": "^5.4.10"
  }
}
